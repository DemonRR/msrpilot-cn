# ════════════════════════════════════════════════════════════════
#  MSRPilot CN（Docker 版）环境变量完整模板
#  使用: 复制为 .env 并填写；install.sh 会自动下载本模板并按向导填充。
#  修改后执行: docker compose up -d 使其生效。
#
#  ★ 配置分三层，改对地方才生效:
#    1) 本文件       = 部署级配置（compose.yaml 通过 ${VAR} 插值读取）
#    2) compose.yaml = TZ / CRON_SCHEDULES / RUN_ON_START 在其 environment
#                      段里改（install.sh 安装时会按向导选择自动写入）
#    3) Web 管理台   = 任务开关、搜索行为、通知等行为配置（「脚本配置」页，
#                      保存到 config/config.json，每次运行读取，改完即生效）
#
#  本模板只列出 compose.yaml 实际引用的变量；未列出的行为配置请用管理台。
# ════════════════════════════════════════════════════════════════

# ── Web 管理台 ──────────────────────────────────────────────────
# compose.yaml 中为必填项（${API_TOKEN:?}），即使不开管理台也要有值。
# 浏览器打开 http://服务器IP:3010/ 时输入；令牌仅保存在浏览器本地。
API_TOKEN=

# ── 授权 ────────────────────────────────────────────────────────
# 留空 = 首次启动自动开始 24 小时免费试用；正式使用填授权码。
# Docker 版与 Win GUI 版授权不互通（按平台绑定）。
LICENSE_KEY=
# 可选：手动固定机器码（换服务器/重建容器时保持授权不变，一般不用填）
LICENSE_MACHINE_CODE=

# ── 微软账号 ────────────────────────────────────────────────────
# 只透传前 2 个账号；第 3 个及以后请在 Web 管理台「账号管理」里添加
# （保存到 config/accounts.json，优先级高于 .env）。
# 密码留空 = 走 token 登录；邮箱留空 = 该槽位不使用。

# 账号 1
ACCOUNT_1_EMAIL=
ACCOUNT_1_PASSWORD=
# 是否参与运行
ACCOUNT_1_ENABLED=true
# 两步验证密钥（Base32），未开启 2FA 留空
ACCOUNT_1_TOTP_SECRET=

# 账号 2
ACCOUNT_2_EMAIL=
ACCOUNT_2_PASSWORD=
ACCOUNT_2_ENABLED=true
ACCOUNT_2_TOTP_SECRET=

# ── 可选账号字段 ────────────────────────────────────────────────
# 以下字段 compose.yaml 默认未透传，需要时请先在 compose.yaml 里
# 取消对应 "${VAR}" 行的注释，再回到这里填值。
#
# 找回邮箱:
#   ACCOUNT_1_RECOVERY_EMAIL=      /  ACCOUNT_2_RECOVERY_EMAIL=
# 地区与语言（国内版固定 CN / zh-CN，仅为兼容旧配置保留）:
#   ACCOUNT_1_GEO_LOCALE=CN        /  ACCOUNT_1_LANG_CODE=zh-CN
# 指纹保存:
#   ACCOUNT_1_SAVE_FINGERPRINT_MOBILE=false
#   ACCOUNT_1_SAVE_FINGERPRINT_DESKTOP=false
# （ACCOUNT_2_* 同理，将 1 换成 2）
# 注: 国内版不使用代理，账号模板不含 PROXY 字段。
